# AI coding-agent launchers (each is a no-op unless the CLI is installed).
# Private, workflow-specific launchers live in the overlay.

alias cc="claude --dangerously-skip-permissions --model claude-opus-5-5 --effort medium"
alias ccol="claude --dangerously-skip-permissions --model claude-opus-5-5 --effort low"
alias ccom="claude --dangerously-skip-permissions --model claude-opus-5-5 --effort medium"
alias ccoh="claude --dangerously-skip-permissions --model claude-opus-5-5 --effort high"
alias ccox="claude --dangerously-skip-permissions --model claude-opus-5-5 --effort xhigh"
alias ccs="claude --dangerously-skip-permissions --model sonnet"
alias ccf="claude --settings '{\"env\":{\"CLAUDE_CODE_AUTO_COMPACT_WINDOW\":\"220000\"}}' --dangerously-skip-permissions --teammate-mode tmux --model fable"
alias cx="codex --yolo --model gpt-6.1-sol --config model_reasoning_effort='\"high\"'"
alias cxl="codex --yolo --model gpt-6-luna --config model_reasoning_effort='\"max\"'"
alias cxsl="codex --yolo --model gpt-6.1-sol --config model_reasoning_effort='\"low\"'"
alias cxsm="codex --yolo --model gpt-6.1-sol --config model_reasoning_effort='\"medium\"'"
alias cxsh="codex --yolo --model gpt-6.1-sol --config model_reasoning_effort='\"high\"'"
alias cxsx="codex --yolo --model gpt-6.1-sol --config model_reasoning_effort='\"max\"'"
alias cxal="codex --yolo --model gpt-6-astra --config model_reasoning_effort='\"low\"'"
alias cxah="codex --yolo --model gpt-6-astra --config model_reasoning_effort='\"high\"'"
alias cz="opencode --model openai/gpt-5.3-codex"
