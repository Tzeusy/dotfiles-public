# AI coding-agent launchers (each is a no-op unless the CLI is installed).
# Private, workflow-specific launchers live in the overlay.

alias cc="claude --dangerously-skip-permissions --model opus --effort medium"
alias ccol="claude --dangerously-skip-permissions --model opus --effort low"
alias ccom="claude --dangerously-skip-permissions --model opus --effort medium"
alias ccoh="claude --dangerously-skip-permissions --model opus --effort high"
alias ccox="claude --dangerously-skip-permissions --model opus --effort xhigh"
alias ccs="claude --dangerously-skip-permissions --model sonnet"
alias ccf="claude --settings '{\"env\":{\"CLAUDE_CODE_AUTO_COMPACT_WINDOW\":\"400000\"}}' --dangerously-skip-permissions --model fable"
alias cx="codex --yolo --model gpt-6.2-sol --config model_reasoning_effort='\"high\"'"
alias cxl="codex --yolo --model gpt-6-luna --config model_reasoning_effort='\"max\"'"
alias cxsl="codex --yolo --model gpt-6.2-sol --config model_reasoning_effort='\"low\"'"
alias cxsm="codex --yolo --model gpt-6.2-sol --config model_reasoning_effort='\"medium\"'"
alias cxsh="codex --yolo --model gpt-6.2-sol --config model_reasoning_effort='\"high\"'"
alias cxsx="codex --yolo --model gpt-6.2-sol --config model_reasoning_effort='\"max\"'"
alias cxtl="codex --yolo --model gpt-6.1-terra --config model_reasoning_effort='\"low\"'"
alias cxth="codex --yolo --model gpt-6.1-terra --config model_reasoning_effort='\"high\"'"
alias cxal="codex --yolo --model gpt-6.2-astra --config model_reasoning_effort='\"low\"'"
alias cxah="codex --yolo --model gpt-6.2-astra --config model_reasoning_effort='\"high\"'"
